<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>brEARk</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="11.0"/>
        </allowed-os-versions>
    </volume-check>

    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
    </choices-outline>

    <choice id="vst3" title="VST3" description="brEARk.vst3 in /Library/Audio/Plug-Ins/VST3 (Ableton Live, Bitwig, Reaper, …)">
        <pkg-ref id="com.totemphonia.brEARk.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit" description="brEARk.component in /Library/Audio/Plug-Ins/Components (Logic Pro, Ableton Live, …)">
        <pkg-ref id="com.totemphonia.brEARk.au"/>
    </choice>

    <pkg-ref id="com.totemphonia.brEARk.vst3">brEARk-vst3.pkg</pkg-ref>
    <pkg-ref id="com.totemphonia.brEARk.au">brEARk-au.pkg</pkg-ref>
</installer-gui-script>
